<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp" android:gravity="center" android:orientation="vertical" android:background="@drawable/offline_card_bg">
    <ImageView android:layout_width="48dp" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingVertical="12dp" android:src="@drawable/ic_file_download_black_36dp" app:tint="@color/offline_green" android:importantForAccessibility="no"/>
    <TextView android:id="@+id/offline_empty_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/offline_empty_title" android:gravity="center" android:textColor="@color/offline_ink" android:textSize="21sp" android:fontFamily="sans-serif-medium"/>
    <TextView android:id="@+id/offline_empty_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/offline_empty_body" android:gravity="center" android:textColor="@color/offline_muted" android:textSize="14sp" android:lineSpacingExtra="4dp"/>
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/offline_browse" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingVertical="12dp" android:layout_marginTop="24dp" android:background="@drawable/offline_primary_bg" android:text="@string/offline_browse" android:textColor="#FFFFFF" android:textAllCaps="false"/>
</LinearLayout>
