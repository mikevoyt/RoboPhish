<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="?attr/selectableItemBackground" android:paddingVertical="8dp" android:focusable="true">
    <TextView android:id="@+id/offline_track_number" android:layout_width="28dp" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/offline_muted"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/offline_track_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="@color/offline_ink"/>
        <TextView android:id="@+id/offline_track_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="12sp" android:textColor="@color/offline_muted"/>
    </LinearLayout>
    <ImageView android:id="@+id/offline_track_icon" android:layout_width="32dp" android:layout_height="32dp" android:padding="4dp" android:importantForAccessibility="no"/>
</LinearLayout>
