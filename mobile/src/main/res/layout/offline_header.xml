<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/offline_hero_bg" android:padding="24dp" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/offline_eyebrow" android:textColor="#FFC3A6" android:textSize="11sp" android:letterSpacing="0.16" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/offline_headline" android:textColor="#FFFFFF" android:textSize="34sp" android:fontFamily="sans-serif-medium" android:lineSpacingExtra="-2dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/offline_intro" android:textColor="#D7E5E2" android:textSize="14sp"/>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="22dp" android:layout_marginBottom="16dp" android:background="#526C70"/>
        <TextView android:id="@+id/offline_stats" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/>
        <TextView android:id="@+id/offline_free" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#D7E5E2" android:textSize="12sp"/>
    </LinearLayout>
    <androidx.appcompat.widget.SwitchCompat android:id="@+id/offline_wifi" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="14dp" android:text="@string/offline_wifi_only" android:textColor="@color/offline_ink" android:textSize="15sp"/>
    <TextView android:id="@+id/offline_wifi_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/offline_muted" android:textSize="12sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/offline_all" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingVertical="12dp" android:minWidth="112dp" android:paddingHorizontal="18dp" android:textAllCaps="false" android:text="@string/offline_all"/>
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/offline_ready_filter" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingVertical="12dp" android:layout_marginStart="8dp" android:paddingHorizontal="18dp" android:textAllCaps="false" android:text="@string/offline_ready_filter"/>
    </LinearLayout>
</LinearLayout>
